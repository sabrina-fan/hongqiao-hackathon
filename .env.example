# NextStop 环境变量模板
# 用法：cp .env.example .env，然后把下面的 xxxxxxxx 换成真实值。
# .env 已在 .gitignore 里；不要把真实 Key 提交、贴聊天、写进截图或日志。

# ---- 运行 ----
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# ---- 模型端点模式 ----
# plan     = 智谱 Coding Plan + 火山 Agent Plan（本次选择；官方条款不允许后端 API 调用，账号风险自担）
# standard = 标准按量 API（合规；正式上线/对外演示优先）
MODEL_ENDPOINT_MODE=plan

# ---- 智谱：视觉主模型 ----
ZHIPU_API_KEY=xxxxxxxx
# plan 模式：Coding Plan 的 OpenAI 兼容端点
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
# standard 模式改成：ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 不要用 /api/anthropic：同样能用，但会忽略 thinking:disabled，且没有 response_format
ZHIPU_MODEL_VISION=glm-5.3-flash

# ---- 智谱：视觉兜底（可选，标准按量 Key，与主 Key 分开计费）----
# 2026-11-16 实测 glm-4.6v-flash 429 高发；不在默认兜底链里，只作主 Key 配额耗尽时的短超时备选
ZHIPU_BACKUP_API_KEY=
ZHIPU_BACKUP_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_BACKUP_MODEL=glm-4.6v-flash

# ---- 火山方舟：文本/意图/理由主模型 ----
ARK_API_KEY=xxxxxxxx
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
# standard 模式改成：ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL_TEXT=doubao-seed-2-1-lite-260915
# 若控制台只给推理接入点：ARK_MODEL_TEXT=ep-xxxxxxxx

# ---- 高德：服务端 Web服务 Key ----
AMAP_SERVER_KEY=xxxxxxxx

# ---- 高德：JS API Key + 安全密钥 ----
AMAP_JS_KEY=xxxxxxxx
AMAP_JS_CODE=xxxxxxxx

# ---- 应用自身（用 `openssl rand -hex 32` 生成，不要复用）----
COOKIE_SECRET=xxxxxxxx
GATEWAY_INTERNAL_TOKEN=xxxxxxxx

# ---- 本地持久化（部署时必须落在持久卷上）----
DATA_DIR=./data
OBJECT_STORE=local
OBJECT_STORE_DIR=./data/objects
# OBJECT_STORE=s3 时另配：
# OBJECT_STORE_ENDPOINT=
# OBJECT_STORE_BUCKET=
# OBJECT_STORE_ACCESS_KEY=
# OBJECT_STORE_SECRET_KEY=
