{
  "name": "nextstop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "node scripts/check-node.mjs",
    "dev": "pnpm build:packages && pnpm -r --parallel --stream dev",
    "build:packages": "pnpm --filter @nextstop/core --filter @nextstop/model-gateway build",
    "build": "pnpm -r build",
    "start:server": "pnpm --filter @nextstop/server start",
    "lint": "oxlint --deny-warnings",
    "format": "node scripts/format-changed.mjs",
    "format:check": "node scripts/format-changed.mjs --check",
    "typecheck": "pnpm build:packages && pnpm -r typecheck && tsc -p tsconfig.tools.json",
    "test": "node scripts/check-test-skips.mjs",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "node e2e/run-ego.mjs",
    "test:model": "node evals/run-model-evals.mjs",
    "test:model:local": "node evals/run-model-evals.mjs --local",
    "qa": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build && pnpm test:e2e",
    "secrets:check-env": "node scripts/check-env-boundary.mjs",
    "secrets:scan": "pnpm secrets:check-env && gitleaks dir --redact --config .gitleaks.toml .",
    "audit:prod": "pnpm audit --prod --audit-level high"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "fast-check": "4.10.2",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "packageManager": "pnpm@11.9.0"
}
